# Copy this file to the project root as .env.production.
# Replace every CHANGE_ME value before building or starting the application.

NEXT_PUBLIC_SITE_URL=https://www.agentmatter.net
NEXT_PUBLIC_GITHUB_URL=https://github.com/maxiaobang7/AgentMatter

# Use a dedicated MySQL user limited to the agentmatter database.
# Prefer a URL-safe hexadecimal password or percent-encode reserved characters.
DATABASE_URL=mysql://agentmatter:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/agentmatter
DATABASE_POOL_SIZE=8

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# Generate with: pnpm admin:hash-password "your private 12+ character password"
ADMIN_PASSWORD_SCRYPT=CHANGE_ME_SALT_AND_SCRYPT_HASH

# Persistent and writable by the Node process user.
AGENTMATTER_MEDIA_DIR=/www/wwwroot/agentmatter/storage/media

# Optional bootstrap Agent token hash. Prefer creating scoped tokens in /admin.
# AGENT_API_TOKEN_SHA256=CHANGE_ME_64_HEX_CHARACTERS

# Optional Google Search Console verification value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=CHANGE_ME
