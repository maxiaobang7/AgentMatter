# Public canonical URL used by metadata, sitemap and robots.txt.
# This value is embedded at build time. Set it before running `pnpm build`.
NEXT_PUBLIC_SITE_URL=https://www.agentmatter.net

# Optional AgentMatter organization or repository link. The GitHub navigation item is hidden when unset.
NEXT_PUBLIC_GITHUB_URL=https://github.com/maxiaobang7/AgentMatter

# Optional Google Search Console ownership token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace-with-google-token

# MySQL 8.0. Run database migration before enabling production traffic.
# DATABASE_URL=mysql://agentmatter:change-me@127.0.0.1:3306/agentmatter
# DATABASE_POOL_SIZE=8

# Admin session HMAC secret, at least 32 random characters.
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Output of: pnpm admin:hash-password "your-long-password"
# ADMIN_PASSWORD_SCRYPT=replace-with-salt-and-scrypt-hash

# Optional bootstrap token hash. Prefer creating a scoped token in /admin.
# Generate the local token and this server-side hash with: pnpm agent:token
# AGENT_API_TOKEN_SHA256=replace-with-sha256

# Persistent production directory for generated resource images.
# AGENTMATTER_MEDIA_DIR=/www/wwwroot/agentmatter/storage/media

# The server never needs an OpenAI API key. GitHub research and AI generation run locally in Codex.
