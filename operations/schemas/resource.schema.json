              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "summary": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
