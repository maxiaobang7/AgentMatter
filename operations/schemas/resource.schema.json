              },
              "placement": {
                "type": "string",
                "enum": [
                  "after-introduction",
                  "after-capabilities",
                  "after-installation",
                  "after-use-cases",
                  "after-review",
                  "in-readme"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 160,
                "maximum": 8000
              },
              "height": {
                "type": "integer",
                "minimum": 120,
                "maximum": 8000
              }
            },
            "required": [
              "id",
              "src",
              "sourceUrl",
              "evidenceUrl",
              "alt",
              "kind",
              "placement",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "structureDetails": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "evidenceUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "path",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "dataBoundaries": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidenceUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "description",
              "risk"
            ],
            "additionalProperties": false
          }
        },
        "licenses": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "spdx": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "scope",
              "spdx",
              "sourceUrl"
            ],
            "additionalProperties": false
          }
        },
        "maintenance": {
          "type": "object",
          "properties": {
            "lastPush": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "archived": {
              "type": "boolean"
            },
            "latestRelease": {
              "type": "string",
              "maxLength": 100
            },
            "releaseUrl": {
              "type": "string",
              "format": "uri"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "lastPush",
            "archived",
            "note"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "categoryFacts": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "introduction",
        "githubDescription",
        "suitableFor",
        "notSuitableFor",
        "readmeSummary",
        "capabilityDetails",
        "structureDetails",
        "dataBoundaries",
        "licenses",
        "maintenance",
        "evidence",
        "categoryFacts"
      ],
      "additionalProperties": false
    },
    "localizations": {
