                "additionalProperties": false
              }
            },
            "acquisitions": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "requirements": {
                    "maxItems": 20,
